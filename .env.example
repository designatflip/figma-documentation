# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# --- Figma -------------------------------------------------------------------
# Personal access token. MUST have BOTH scopes:
#   - file read
#   - file_dev_resources:read
# Without the second, sync appears to succeed but every source link and drift
# signal is silently dropped. Verify with: npm run sync -- --check-token
FIGMA_ACCESS_TOKEN=

# The Figma project (folder) used exclusively for documentation.
# Open the folder in Figma; the URL is /files/project/<THIS_NUMBER>/...
FIGMA_PROJECT_ID=

# Tier 1 endpoints are limited by plan: 10/min Starter, 15/min Professional,
# 20/min Organization, unlimited Enterprise. Set to match your plan.
FIGMA_RATE_LIMIT_PER_MIN=10

# Frames and files whose names match this are never published.
DOCS_IGNORE_PATTERN=^(_|wip|scratch)

# --- Storage -----------------------------------------------------------------
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# --- Auth --------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk's allowlist is paid-only in production, so this domain IS the access
# boundary — enforced in lib/auth.ts, not in the Clerk dashboard.
ALLOWED_EMAIL_DOMAIN=flip.id

# From the Clerk dashboard endpoint that feeds /api/webhooks/clerk. Each
# endpoint has its own secret, so development and production values differ.
# Without it the handler rejects every event as unverified (400).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Cron --------------------------------------------------------------------
# Any long random string: openssl rand -hex 32
CRON_SECRET=
